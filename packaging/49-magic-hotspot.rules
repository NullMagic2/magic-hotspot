// Fixed operation only: local active users may start the installed USB helper.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "magic-hotspot-usb.service" &&
        action.lookup("verb") === "start" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
